{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosariotecno.local/schemas/feature.schema.json",
  "title": "Feature",
  "description": "Contrato de validacion para la definicion de Features de un Business Process. Valida unicamente la forma del YAML (Etapa 2: Feature Definition); no valida referencias cruzadas contra process_nodes, business_rules ni la version de source_process contra el Business Process real. Eso es una evolucion posterior.",
  "type": "object",
  "required": ["process", "features"],
  "additionalProperties": true,
  "properties": {
    "process": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/feature" }
    }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "source_process",
        "purpose",
        "inputs",
        "outputs",
        "process_nodes",
        "business_rules",
        "scope",
        "open_questions"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "source_process": { "$ref": "#/definitions/sourceProcess" },
        "purpose": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "process_nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "business_rules": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "scope": { "$ref": "#/definitions/scope" },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "sourceProcess": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["includes", "excludes"],
      "additionalProperties": true,
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  }
}
